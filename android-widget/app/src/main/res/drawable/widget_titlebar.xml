<?xml version="1.0" encoding="utf-8"?>
<!-- Windows 98 제목 막대(둥근): 남색 → 하늘색 + Y2K 유리 광택(위쪽 하이라이트) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#000080" android:endColor="#1084D0" android:angle="0" />
            <corners android:radius="7dp" />
        </shape>
    </item>
    <item android:bottom="9dp">
        <shape android:shape="rectangle">
            <gradient android:startColor="#66FFFFFF" android:endColor="#08FFFFFF" android:angle="270" />
            <corners android:topLeftRadius="7dp" android:topRightRadius="7dp" android:bottomLeftRadius="2dp" android:bottomRightRadius="2dp" />
        </shape>
    </item>
</layer-list>
