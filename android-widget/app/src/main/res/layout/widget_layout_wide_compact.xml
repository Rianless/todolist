<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="8dp">

    <LinearLayout
        android:layout_width="88dp"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/wide_compact_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:text="오늘"
            android:textColor="#1F2430"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wide_compact_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="0개 · 스크롤"
            android:textColor="#6366F1"
            android:textSize="9sp" />
    </LinearLayout>

    <TextView
        android:layout_width="1dp"
        android:layout_height="34dp"
        android:background="#E4E7EF"
        android:text="" />

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="4dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/wide_compact_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:fadingEdge="vertical"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/wide_compact_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:text="오늘 일정이 없습니다"
            android:textColor="#A8ADBC"
            android:textSize="11sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/wide_compact_add"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="5dp"
        android:background="@drawable/bg_widget_btn"
        android:gravity="center"
        android:text="+"
        android:textColor="#6366F1"
        android:textSize="19sp" />

</LinearLayout>
