<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_popup_win98"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="9dp">

        <!-- 제목 막대: 위젯과 같은 남색 → 하늘색 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_titlebar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="4dp"
            android:paddingVertical="4dp">

            <TextView
                android:id="@+id/dialog_category"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dialog_done_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_popup_chip_win98"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="완료"
                android:textColor="#006000"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/dialog_btn_close"
                android:layout_width="30dp"
                android:layout_height="26dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_widget_btn"
                android:gravity="center"
                android:text="✕"
                android:textColor="#000000"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 본문: 들어간 흰 칸 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/widget_todo_card_bg"
            android:orientation="vertical"
            android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/dialog_accent_bar"
                android:layout_width="5dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="10dp"
                android:background="#6366F1" />

        <TextView
            android:id="@+id/dialog_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingMultiplier="1.2"
            android:textColor="#000000"
            android:textSize="19sp"
            android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="#C0C0C0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="9dp">
                <TextView android:layout_width="72dp" android:layout_height="wrap_content" android:text="날짜" android:textColor="#555555" android:textSize="12sp" />
                <TextView android:id="@+id/dialog_date" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:textColor="#000000" android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="9dp">
                <TextView android:layout_width="72dp" android:layout_height="wrap_content" android:text="시간" android:textColor="#555555" android:textSize="12sp" />
                <TextView android:id="@+id/dialog_time" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:textColor="#000000" android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/dialog_row_module" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingVertical="9dp" android:visibility="gone">
                <TextView android:layout_width="72dp" android:layout_height="wrap_content" android:text="분류" android:textColor="#555555" android:textSize="12sp" />
                <TextView android:id="@+id/dialog_module" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:textColor="#000000" android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/dialog_row_instructor" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingVertical="9dp" android:visibility="gone">
                <TextView android:layout_width="72dp" android:layout_height="wrap_content" android:text="담당" android:textColor="#555555" android:textSize="12sp" />
                <TextView android:id="@+id/dialog_instructor" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:textColor="#000000" android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/dialog_row_location" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingVertical="9dp" android:visibility="gone">
                <TextView android:layout_width="72dp" android:layout_height="wrap_content" android:text="장소" android:textColor="#555555" android:textSize="12sp" />
                <TextView android:id="@+id/dialog_location" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:textColor="#000000" android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/dialog_row_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="12dp" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="메모" android:textColor="#555555" android:textSize="12sp" />
                <TextView android:id="@+id/dialog_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:background="@drawable/bg_note_box" android:lineSpacingMultiplier="1.4" android:padding="12dp" android:textColor="#555B6D" android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/dialog_row_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="12dp" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="내용" android:textColor="#555555" android:textSize="12sp" />
                <TextView android:id="@+id/dialog_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:background="@drawable/bg_content_box" android:lineSpacingMultiplier="1.5" android:padding="12dp" android:textColor="#000000" android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/dialog_row_checklist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="14dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/dialog_checklist_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="체크리스트"
                    android:textColor="#555555"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/dialog_checklist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_content_box"
                    android:orientation="vertical"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp" />
            </LinearLayout>
        </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <TextView android:id="@+id/dialog_btn_done" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:background="@drawable/bg_widget_btn" android:gravity="center" android:text="완료" android:textColor="#006000" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:id="@+id/dialog_btn_edit" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@drawable/bg_widget_btn" android:gravity="center" android:text="수정" android:textColor="#000080" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:id="@+id/dialog_btn_delete" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@drawable/bg_widget_btn" android:gravity="center" android:text="삭제" android:textColor="#C00000" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">
            <TextView android:id="@+id/dialog_btn_up" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:background="@drawable/bg_widget_btn" android:gravity="center" android:text="▲ 순서 위로" android:textColor="#000080" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:id="@+id/dialog_btn_down" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@drawable/bg_widget_btn" android:gravity="center" android:text="▼ 순서 아래로" android:textColor="#000080" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
