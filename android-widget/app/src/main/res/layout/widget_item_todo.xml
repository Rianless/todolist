<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/widget_todo_card_bg"
    android:layout_marginLeft="10dp"
    android:layout_marginRight="10dp"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="2dp"
    android:minHeight="62dp">

    <TextView
        android:id="@+id/widget_item_accent"
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:minHeight="62dp"
        android:background="#4a4f72"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingLeft="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:paddingRight="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="5dp">

            <TextView
                android:id="@+id/widget_item_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textColor="#00ffe7"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="#00000000"
                android:layout_marginRight="7dp"/>

            <TextView
                android:id="@+id/widget_item_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textColor="#4a4f72"/>

        </LinearLayout>

        <TextView
            android:id="@+id/widget_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:textColor="#e8eaf6"
            android:singleLine="true"
            android:ellipsize="end"/>

    </LinearLayout>

    <!-- 체크 영역: 탭 → 완료 토글 -->
    <LinearLayout
        android:id="@+id/widget_item_check_area"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="top|right">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&#x250C;"
            android:textSize="12sp"
            android:textColor="#2a2d4a"
            android:fontFamily="monospace"
            android:layout_marginRight="4dp"
            android:layout_marginTop="3dp"/>

        <TextView
            android:id="@+id/widget_item_check"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginRight="8dp"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:text=""
            android:textColor="#2a2d4a"
            android:background="#00000000"/>

    </LinearLayout>

</LinearLayout>