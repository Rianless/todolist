<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_marginTop="3dp"
    android:layout_marginEnd="10dp"
    android:layout_marginBottom="3dp"
    android:background="@drawable/widget_todo_card_bg"
    android:orientation="vertical">

    <!-- 웹앱과 동일하게 선택/분류 강조선을 카드 상단 가로선으로 표시 -->
    <TextView
        android:id="@+id/widget_item_accent"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:text="" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="7dp"
        android:paddingEnd="10dp"
        android:paddingBottom="9dp">

        <LinearLayout
            android:id="@+id/widget_item_content_root"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_item_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_widget_chip"
                    android:fontFamily="monospace"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="2dp"
                    android:textColor="#6366F1"
                    android:textSize="8sp" />

                <TextView
                    android:id="@+id/widget_item_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="monospace"
                    android:textColor="#8A90A2"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_item_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:textColor="#767B8D"
                    android:textSize="9sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_item_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:textColor="#1F2430"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_item_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#8A90A2"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_item_check"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_widget_check"
            android:gravity="center"
            android:text="" />
    </LinearLayout>
</LinearLayout>
